        WHEN CAST(PRICE_PER_NIGHT AS INT) < 200 THEN 'MEDIUM'
        ELSE 'HIGH'
    END    
 AS PRICE_PER_NIGHT_TAG,
    CREATED_AT 
FROM 
    AIRBNB.bronze.bronze_listings
  )
